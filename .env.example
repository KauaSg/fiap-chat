# URL publica da API de notificacoes (backend separado do app mobile)
EXPO_PUBLIC_API_URL=https://fiap-chat.onrender.com

# As imagens usam Cloudinary. Os valores abaixo sao configuracoes publicas do cliente,
# nao credenciais administrativas. A configuracao entregue tambem esta em cloudinaryConfig.json.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=mbrxdkrq
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=fiap_chat_unsigned
